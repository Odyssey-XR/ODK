<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.3.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ODK.Attributes\ODK.Attributes.csproj" />
      <ProjectReference Include="..\ODK.Injection.Attributes\ODK.Injection.Attributes.csproj" />
      <ProjectReference Include="..\ODK.Interfaces\ODK.Interfaces.csproj" />
      <ProjectReference Include="..\ODK.Roslyn.SyntaxReceivers\ODK.Roslyn.SyntaxReceivers.csproj" />
    </ItemGroup>

    <Target Name="CopyFiles" AfterTargets="Build">
        <ItemGroup>
            <OutputFiles Include="$(OutputPath)**\*.dll"/>
        </ItemGroup>
        <Copy SourceFiles="@(OutputFiles)" DestinationFolder="$(OutputPath)..\..\..\..\..\..\Runtime"/>
    </Target>

</Project>
